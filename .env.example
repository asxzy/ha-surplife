# Copy to .env and fill in. Never commit .env.
#
# Home Assistant long-lived access token, used only by tools/ scripts for
# verification and deployment. The integration itself never needs it.
HA_TOKEN=

# Home Assistant base URL
HA_URL=http://192.168.1.10:8123

# Optional: override the devices probed by tools/surplife_cli.py
# SURPLIFE_HOSTS=192.168.1.51,192.168.1.50,192.168.1.52
